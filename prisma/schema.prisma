// Modelo de datos de Aula Click (T-01).
//
// Convenciones (docs/convenciones-backend.md):
// - Modelos en PascalCase y campos en camelCase; tablas y columnas en snake_case con @@map / @map.
// - Fechas de calendario con @db.Date; horas en minutos desde medianoche (Int); día de la semana ISO 1..7.
// - Auditoría en cada entidad de negocio: createdById, updatedById, createdAt, updatedAt.
// - Baja lógica con el enum Estado: nada se borra.
// - Las migraciones las genera sólo Prisma, sin SQL a mano (decisión T-50): las restricciones que
//   Prisma no expresa (CHECK de profesor, aula, bloque_agenda, turno, materia y pago; índices
//   parciales) las valida por ahora la API, y pasarlas a la base queda pendiente.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Estado {
  ACTIVO
  INACTIVO
}

enum NivelEscolaridad {
  INICIAL
  PRIMARIO
  SECUNDARIO
  TERCIARIO
  UNIVERSITARIO
}

enum TipoTurno {
  RECURRENTE
  SESION_UNICA
}

// La vigencia de un turno se calcula por fechas, nunca por este estado.
enum EstadoTurno {
  ACTIVO
  CANCELADO
}

// Motivo compartido por cancelar una ocurrencia (HU-13) y finalizar una recurrencia (HU-14).
enum MotivoCancelacion {
  CANCELACION_ALUMNO
  CANCELACION_PROFESOR
  PROBLEMA_ADMINISTRATIVO
  OTRO
}

enum TipoExamen {
  PARCIAL
  FINAL
  RECUPERATORIO
  TRABAJO_PRACTICO
  OTRO
}

enum EstadoPago {
  VIGENTE
  ANULADO
}

// ---------- Usuarios y roles ----------

// Catálogo que carga el seed. Sin auditoría.
model Rol {
  id          String  @id // MESA_ENTRADAS, PROFESOR, GERENTE, ALUMNO
  nombre      String
  descripcion String?
  estado      Estado  @default(ACTIVO)

  usuarios Usuario[]

  @@map("rol")
}

// Usuario de dominio y de Better Auth (user.modelName: 'usuario' en src/lib/auth.ts).
// La contraseña no vive acá: está en Account.password (providerId 'credential').
// Su estado es también la baja lógica del profesor.
model Usuario {
  id              String    @id // lo genera Better Auth (o el seed)
  nombre          String // Better Auth: name
  apellido        String
  dni             String    @unique
  busqueda        String
  telefono        String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String? // lo exige Better Auth; sin uso (la foto va por avatarKey)
  role            String    @map("rol_id")
  avatarKey       String?   @map("avatar_key")
  avatarMimeType  String?   @map("avatar_mime_type")
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  estado          Estado    @default(ACTIVO)

  // Autorreferencia: opcionales porque el seed no tiene creador.
  createdById String?  @map("usuario_creador_id")
  updatedById String?  @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  rol       Rol      @relation(fields: [role], references: [id], onDelete: Restrict)
  createdBy Usuario? @relation("UsuarioCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario? @relation("UsuarioModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  sessions Session[]
  accounts Account[]
  profesor Profesor?

  // Relaciones inversas de auditoría.
  usuariosCreados                  Usuario[]                 @relation("UsuarioCreador")
  usuariosModificados              Usuario[]                 @relation("UsuarioModificador")
  alumnosCreados                   Alumno[]                  @relation("AlumnoCreador")
  alumnosModificados               Alumno[]                  @relation("AlumnoModificador")
  materiasCreadas                  Materia[]                 @relation("MateriaCreador")
  materiasModificadas              Materia[]                 @relation("MateriaModificador")
  asignacionesCreadas              AsignacionMateria[]       @relation("AsignacionMateriaCreador")
  asignacionesModificadas          AsignacionMateria[]       @relation("AsignacionMateriaModificador")
  bloquesCreados                   BloqueAgenda[]            @relation("BloqueAgendaCreador")
  bloquesModificados               BloqueAgenda[]            @relation("BloqueAgendaModificador")
  turnosCreados                    Turno[]                   @relation("TurnoCreador")
  turnosModificados                Turno[]                   @relation("TurnoModificador")
  examenesCreados                  Examen[]                  @relation("ExamenCreador")
  examenesModificados              Examen[]                  @relation("ExamenModificador")
  cancelacionesTurnoCreadas        CancelacionTurno[]        @relation("CancelacionTurnoCreador")
  finalizacionesRecurrenciaCreadas FinalizacionRecurrencia[] @relation("FinalizacionRecurrenciaCreador")
  formasPagoCreadas                FormaPago[]               @relation("FormaPagoCreador")
  formasPagoModificadas            FormaPago[]               @relation("FormaPagoModificador")
  pagosCreados                     Pago[]                    @relation("PagoCreador")
  pagosModificados                 Pago[]                    @relation("PagoModificador")

  @@index([apellido])
  @@index([busqueda])
  @@index([role])
  @@index([createdById])
  @@index([updatedById])
  @@map("usuario")
}

// ---------- Tablas de Better Auth (infraestructura) ----------
// Conservan los nombres de modelo y de campo que espera Better Auth 1.7.5
// (@better-auth/core/dist/db/get-tables.mjs). La relación hacia Usuario se llama `usuario`,
// que es la clave que arma el adaptador de Prisma para los joins (nombre del modelo en minúsculas).

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("usuario_id")

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("usuario_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String? // hash de la contraseña (providerId 'credential')
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ---------- Profesores ----------

// Sin estado ni auditoría propios: los toma de su Usuario (datos personales, busqueda y baja lógica).
// capacidad: cantidad máxima de alumnos que el profesor atiende a la vez en una franja de una hora
// (HU-02, decisión T-27). capacidad >= 1: lo valida la API (el CHECK en la base queda pendiente,
// decisión T-50). La capacidad efectiva de una hora (mínimo con la del aula) se calculará al leer,
// en HU-05/HU-07: no se persiste acá.
model Profesor {
  id        Int    @id @default(autoincrement())
  usuarioId String @unique @map("usuario_id")
  titulo    String
  matricula String @unique
  capacidad Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  asignaciones AsignacionMateria[]
  bloques      BloqueAgenda[]

  @@map("profesor")
}

// ---------- Alumnos ----------

// Sin vínculo a Usuario todavía: el portal del alumno llega en el Sprint 3.
// Los datos del tutor son obligatorios si el alumno es menor: lo valida la API, no la base.
// telefono y email son nullable (T-29/HU-02): opcionales si el alumno es menor y tiene tutor
// con sus propios datos de contacto; la obligatoriedad según la edad la valida la API.
model Alumno {
  id                   Int               @id @default(autoincrement())
  nombre               String
  apellido             String
  dni                  String            @unique
  busqueda             String
  fechaNacimiento      DateTime          @map("fecha_nacimiento") @db.Date
  telefono             String?
  email                String?
  tutorNombre          String?           @map("tutor_nombre")
  tutorApellido        String?           @map("tutor_apellido")
  tutorDni             String?           @map("tutor_dni")
  tutorTelefono        String?           @map("tutor_telefono")
  tutorEmail           String?           @map("tutor_email")
  nivelEscolaridad     NivelEscolaridad? @map("nivel_escolaridad")
  grado                String?
  institucionEducativa String?           @map("institucion_educativa")
  observaciones        String?
  estado               Estado            @default(ACTIVO)

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  createdBy Usuario @relation("AlumnoCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario @relation("AlumnoModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  turnos   Turno[]
  examenes Examen[]
  pagos    Pago[]

  @@index([apellido])
  @@index([busqueda])
  @@index([createdById])
  @@index([updatedById])
  @@map("alumno")
}

// ---------- Materias ----------

model Materia {
  id          Int      @id @default(autoincrement())
  nombre      String
  // Nombre normalizado con normalizarBusqueda(): "Matemática" y "matematica" chocan.
  busqueda    String   @unique
  descripcion String?
  // Precio por hora de clase (HU-12), nullable: null = "Sin precio". precio_hora > 0 cuando no es
  // nulo: lo valida la API (el CHECK en la base queda pendiente, decisión T-50). Las materias sin
  // precio quedan en INACTIVO (lo hace prisma/seed.ts, no la migración): no se ofrecen para asignar
  // a profesores ni para registrar turnos hasta que el gerente les cargue un precio y las reactive.
  precioHora  Decimal? @map("precio_hora") @db.Decimal(10, 2)
  estado      Estado   @default(ACTIVO)

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  createdBy Usuario @relation("MateriaCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario @relation("MateriaModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  asignaciones AsignacionMateria[]
  turnos       Turno[]
  examenes     Examen[]

  @@index([createdById])
  @@index([updatedById])
  @@map("materia")
}

// Quitar una materia = pasar a INACTIVO; reasignarla = reactivar esta misma fila.
model AsignacionMateria {
  id         Int    @id @default(autoincrement())
  profesorId Int    @map("profesor_id")
  materiaId  Int    @map("materia_id")
  estado     Estado @default(ACTIVO)

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  profesor  Profesor @relation(fields: [profesorId], references: [id], onDelete: Restrict)
  materia   Materia  @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  createdBy Usuario  @relation("AsignacionMateriaCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario  @relation("AsignacionMateriaModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  // El índice único (profesor_id, materia_id) cubre también las búsquedas por profesor_id.
  @@unique([profesorId, materiaId])
  @@index([materiaId])
  @@index([createdById])
  @@index([updatedById])
  @@map("asignacion_materia")
}

// ---------- Agenda y turnos ----------

// Catálogo que carga el seed (T-14, HU-05): sin ABM en este release, sólo lectura. Sin auditoría,
// igual que Rol. capacidad > 0: lo valida la API (el CHECK en la base queda pendiente, decisión
// T-50).
model Aula {
  id        Int    @id @default(autoincrement())
  nombre    String @unique
  capacidad Int
  estado    Estado @default(ACTIVO)

  bloques BloqueAgenda[]

  @@map("aula")
}

// Lo valida la API (el CHECK en la base queda pendiente, decisión T-50): dia_semana 1..7,
// hora_inicio 0..1439, hora_fin 1..1440, hora_fin > hora_inicio.
// La capacidad efectiva de la hora es min(profesor.capacidad, aula.capacidad) (T-14, resuelve
// D-12): no se persiste acá, se calcula al leer, igual que las ocurrencias de un recurrente.
model BloqueAgenda {
  id         Int    @id @default(autoincrement())
  profesorId Int    @map("profesor_id")
  aulaId     Int    @map("aula_id")
  diaSemana  Int    @map("dia_semana") // ISO: 1 = lunes … 7 = domingo
  horaInicio Int    @map("hora_inicio") // minutos desde medianoche
  horaFin    Int    @map("hora_fin") // minutos desde medianoche
  estado     Estado @default(ACTIVO)

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  profesor  Profesor @relation(fields: [profesorId], references: [id], onDelete: Restrict)
  aula      Aula     @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  createdBy Usuario  @relation("BloqueAgendaCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario  @relation("BloqueAgendaModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  turnos Turno[]

  @@index([profesorId, diaSemana])
  @@index([aulaId])
  @@index([aulaId, diaSemana])
  @@index([createdById])
  @@index([updatedById])
  @@map("bloque_agenda")
}

// Un turno es una hora de un bloque (una fila de bloque_agenda). Un RECURRENTE guarda la regla
// (fechaInicio y fechaFin opcional; null = sin fin) y sus ocurrencias son las fechas de ese día de
// la semana dentro del rango, calculadas al consultar. No hay excepciones: un recurrente creado
// solo en las fechas con lugar se guarda como varios turnos RECURRENTE ("tramos") que saltean las
// fechas llenas (T-37). En una SESION_UNICA, fechaFin = fechaInicio. La prioridad no se persiste:
// la calcula la API por ocurrencia (HU-18). Lo valida la API (el CHECK en la base queda pendiente,
// decisión T-50): fecha_fin >= fecha_inicio; SESION_UNICA => fecha_fin = fecha_inicio.
//
// Ocurrencia: el turno en una fecha concreta, identificada por (turnoId, fecha). Es lo que se
// cancela (CancelacionTurno), se paga (PagoTurno) y tiene prioridad; no tiene una "fecha original"
// distinta de su fecha.
//
// Fin efectivo: finalizar una serie (HU-14, FinalizacionRecurrencia) no modifica fechaFin. El fin
// efectivo es el menor entre fechaFin y el día anterior a FinalizacionRecurrencia.fechaDesde.
//
// Reprogramar (HU-20) edita el turno que ya existe, sin tabla propia (la regla la implementa la
// API, T-49):
// - SESION_UNICA: se cambian bloqueAgendaId, fechaInicio y fechaFin.
// - RECURRENTE: sólo se mueve esa fecha y la serie se parte en tramos. El turno original termina
//   en la ocurrencia anterior; un tramo nuevo sigue desde la ocurrencia siguiente, y la fecha
//   movida pasa a ser una SESION_UNICA nueva en el destino, que copia alumno, materia,
//   observaciones y temas. Las CancelacionTurno y los PagoTurno de las fechas que cambian de
//   turno se vuelven a apuntar al turno nuevo, en la misma transacción.
// No se guarda desde qué fecha se reprogramó: quién lo modificó y cuándo sale de la auditoría del
// turno (updatedById, updatedAt).
//
// A partir del Sprint 2 (T-29), una cancelación se registra siempre en CancelacionTurno (también
// la de una sesión única): el valor CANCELADO de EstadoTurno queda sólo para los turnos
// cancelados antes de este sprint.
model Turno {
  id             Int         @id @default(autoincrement())
  bloqueAgendaId Int         @map("bloque_agenda_id")
  alumnoId       Int         @map("alumno_id")
  materiaId      Int         @map("materia_id")
  tipo           TipoTurno
  fechaInicio    DateTime    @map("fecha_inicio") @db.Date
  fechaFin       DateTime?   @map("fecha_fin") @db.Date
  // "Observaciones" (T-29; antes "motivo de consulta"): texto libre, opcional. La migración de T-29
  // dropeó motivo_consulta y creó esta columna, sin copiar los datos (decisión T-51).
  observaciones  String?
  // "Temas a trabajar" (HU-08): opcional en RECURRENTE, obligatorio en SESION_UNICA (lo valida la API).
  temas          String?
  estado         EstadoTurno @default(ACTIVO)
  // Serie (decisión T-103): agrupa todo lo que se registró en un mismo alta RECURRENTE, es decir,
  // todas sus horas (una fila por hora) y todos sus tramos (por fechas sin lugar, HU-08, o por una
  // reprogramación, HU-20, cuyo tramo nuevo hereda el del original). Finalizar (HU-14) actúa sobre
  // las filas con el mismo serieId y la misma hora (bloqueAgendaId). Null en una SESION_UNICA y en
  // los recurrentes anteriores a esta columna: un recurrente sin serieId es una serie de una sola
  // fila.
  serieId        String?     @map("serie_id") @db.Uuid

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  bloqueAgenda BloqueAgenda @relation(fields: [bloqueAgendaId], references: [id], onDelete: Restrict)
  alumno       Alumno       @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  materia      Materia      @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  createdBy    Usuario      @relation("TurnoCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Usuario      @relation("TurnoModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  cancelaciones CancelacionTurno[]
  finalizacion  FinalizacionRecurrencia?
  pagoTurnos    PagoTurno[]

  @@index([bloqueAgendaId, fechaInicio])
  @@index([alumnoId])
  @@index([materiaId])
  @@index([serieId])
  @@index([createdById])
  @@index([updatedById])
  @@map("turno")
}

// Examen de un alumno en una materia (T-29, reemplaza a ExamenMateria: la migración de T-29 dropeó
// esa tabla sin copiar sus datos, decisión T-51). De él depende la prioridad del turno (HU-18). Baja lógica
// ("eliminar" de HU-17): nada se borra.
model Examen {
  id            Int        @id @default(autoincrement())
  alumnoId      Int        @map("alumno_id")
  materiaId     Int        @map("materia_id")
  fecha         DateTime   @db.Date
  tipo          TipoExamen
  observaciones String?    @db.VarChar(500)
  estado        Estado     @default(ACTIVO)

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  alumno    Alumno  @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  materia   Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  createdBy Usuario @relation("ExamenCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario @relation("ExamenModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  // Sin único por (alumno, materia, fecha): "un examen pendiente por materia" lo valida la API
  // (HU-17), no la base. El índice sigue sirviendo para esa consulta.
  @@index([alumnoId, materiaId, fecha])
  @@index([materiaId])
  @@index([createdById])
  @@index([updatedById])
  @@map("examen")
}

// ---------- Cancelaciones y finalizaciones de turnos ----------

// Cancelación de UNA ocurrencia de un turno (HU-13), identificada por (turnoId, fechaOcurrencia),
// que es simplemente la fecha de la ocurrencia: un recurrente sigue agendado en sus demás fechas. A partir de este sprint
// toda cancelación pasa por acá, también la de una sesión única (ver comentario en Turno). En
// este incremento no se deshace una cancelación.
model CancelacionTurno {
  id              Int               @id @default(autoincrement())
  turnoId         Int               @map("turno_id")
  fechaOcurrencia DateTime          @map("fecha_ocurrencia") @db.Date
  motivo          MotivoCancelacion
  detalle         String?           @db.VarChar(500)

  createdById String   @map("usuario_creador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")

  turno     Turno   @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  createdBy Usuario @relation("CancelacionTurnoCreador", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([turnoId, fechaOcurrencia])
  @@index([createdById])
  @@map("cancelacion_turno")
}

// Fin anticipado de una serie recurrente desde una fecha (HU-14): a lo sumo una por turno. No
// modifica Turno.fechaFin: el fin efectivo es el menor entre fechaFin y el día anterior a
// fechaDesde. Finalizar actúa por hora (decisión T-104): crea una fila, con la misma fechaDesde, en
// cada turno de la serie (Turno.serieId) y de la misma hora (bloqueAgendaId) que tiene fechas
// desde ahí. Las otras horas de la serie no se finalizan: la API las informa.
model FinalizacionRecurrencia {
  id         Int               @id @default(autoincrement())
  turnoId    Int               @unique @map("turno_id")
  fechaDesde DateTime          @map("fecha_desde") @db.Date
  motivo     MotivoCancelacion
  detalle    String?           @db.VarChar(500)

  createdById String   @map("usuario_creador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")

  turno     Turno   @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  createdBy Usuario @relation("FinalizacionRecurrenciaCreador", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@map("finalizacion_recurrencia")
}

// ---------- Pagos ----------

// Catálogo de formas de pago (HU-15/HU-23). El seed carga "Efectivo", único medio de este sprint;
// el ABM completo es HU-23, fuera de alcance.
model FormaPago {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  estado Estado @default(ACTIVO)

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  createdBy Usuario @relation("FormaPagoCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario @relation("FormaPagoModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  pagos Pago[]

  @@index([createdById])
  @@index([updatedById])
  @@map("forma_pago")
}

// Un pago de un alumno, que puede incluir una o varias de sus ocurrencias (PagoTurno) y genera
// un único comprobante. numeroComprobante es correlativo y no se repite (HU-15).
// montoRecibido es opcional y, si viene, es >= importeTotal: lo valida la API (el CHECK en la base
// queda pendiente, decisión T-50). El vuelto lo calcula y lo devuelve la API: no se guarda.
// estado queda sin uso en este sprint: todo pago nace VIGENTE; la anulación llega en el próximo.
model Pago {
  id                Int        @id @default(autoincrement())
  alumnoId          Int        @map("alumno_id")
  formaPagoId       Int        @map("forma_pago_id")
  numeroComprobante Int        @unique @default(autoincrement()) @map("numero_comprobante")
  importeTotal      Decimal    @map("importe_total") @db.Decimal(10, 2)
  fechaPago         DateTime   @map("fecha_pago") @db.Date
  montoRecibido     Decimal?   @map("monto_recibido") @db.Decimal(10, 2)
  observaciones     String?    @db.VarChar(500)
  estado            EstadoPago @default(VIGENTE)

  createdById String   @map("usuario_creador_id")
  updatedById String   @map("usuario_modificador_id")
  createdAt   DateTime @default(now()) @map("fecha_hora_creacion")
  updatedAt   DateTime @updatedAt @map("fecha_hora_modificacion")

  alumno    Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  formaPago FormaPago @relation(fields: [formaPagoId], references: [id], onDelete: Restrict)
  createdBy Usuario   @relation("PagoCreador", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy Usuario   @relation("PagoModificador", fields: [updatedById], references: [id], onDelete: Restrict)

  turnos PagoTurno[]

  @@index([alumnoId])
  @@index([formaPagoId])
  @@index([createdById])
  @@index([updatedById])
  @@map("pago")
}

// Ocurrencias incluidas en un pago, identificadas igual que una cancelación: (turnoId, fecha de la
// ocurrencia), sin "fecha original". Una ocurrencia se paga una sola vez y lo garantiza el único
// (turnoId, fechaOcurrencia); vale mientras no exista la anulación de pagos, que lo va a tener que
// reemplazar (decisión T-49).
model PagoTurno {
  id              Int      @id @default(autoincrement())
  pagoId          Int      @map("pago_id")
  turnoId         Int      @map("turno_id")
  fechaOcurrencia DateTime @map("fecha_ocurrencia") @db.Date
  importeAplicado Decimal  @map("importe_aplicado") @db.Decimal(10, 2)

  pago  Pago  @relation(fields: [pagoId], references: [id], onDelete: Restrict)
  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Restrict)

  @@unique([turnoId, fechaOcurrencia])
  @@index([pagoId])
  @@map("pago_turno")
}

# Variables validadas por src/config/env.ts (la app no arranca si falta alguna).
# Copiar a .env y ajustar. No commitear el .env.

# ---------- Base de datos ----------
# Coincide con el usuario/clave/base por defecto de docker-compose.yml.
DATABASE_URL="postgresql://aula_click:aula_click_dev_pass@localhost:5434/aula_click_db?schema=public"

# ---------- Almacenamiento (MinIO / S3) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=aula-click-data

# ---------- Autenticación ----------
# OBLIGATORIO (mínimo 32 caracteres). Generarlo con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------- Seed (solo desarrollo) ----------
# Usuarios que crea `pnpm db:seed` (uno por rol). Opcionales para la app; obligatorias para el seed.
# Contraseñas de al menos 8 caracteres. Nunca usar estos valores fuera de desarrollo local.
SEED_MESA_ENTRADAS_EMAIL=mesa@aulaclick.local
SEED_MESA_ENTRADAS_PASSWORD=mesa-dev-1234
SEED_PROFESOR_EMAIL=profesor@aulaclick.local
SEED_PROFESOR_PASSWORD=profesor-dev-1234
SEED_GERENTE_EMAIL=gerente@aulaclick.local
SEED_GERENTE_PASSWORD=gerente-dev-1234
